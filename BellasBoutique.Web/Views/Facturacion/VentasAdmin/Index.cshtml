@model VentasViewModel
@{
    const string titulo = "Ventas";
    ViewData["Title"] = titulo;
    var estados = new SelectList(Enum.GetNames<EstadoPago>());
}

@section Estilos {
    <link rel="stylesheet" href="~/css/facturacion.css" asp-append-version="true" />
}

<partial name="_CabeceraPagina" model="new CabeceraPaginaModelo(titulo)" />

<form method="get" class="tarjeta filtros-ventas" aria-label="Filtrar ventas">
    <campo-formulario asp-for="Filtro.Estado">
        <select asp-for="Filtro.Estado" asp-items="estados">
            <option value="">Todos</option>
        </select>
    </campo-formulario>
    <campo-formulario asp-for="Filtro.Desde">
        <input asp-for="Filtro.Desde" type="date" />
    </campo-formulario>
    <campo-formulario asp-for="Filtro.Hasta">
        <input asp-for="Filtro.Hasta" type="date" />
    </campo-formulario>
    <div class="filtros-ventas__acciones">
        <button type="submit" class="btn-primary">Filtrar</button>
        <a class="btn-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="tarjeta tabla-contenedor">
    <table class="tabla">
        <thead>
            <tr>
                <th class="tabla__columna-fecha">Fecha</th>
                <th class="tabla__columna-factura">Factura</th>
                <th>Producto</th>
                <th class="tabla__columna-cantidad tabla__numero">Cant.</th>
                <th class="tabla__columna-precio-unitario tabla__numero">Precio unitario</th>
                <th class="tabla__columna-total tabla__numero">Total</th>
                <th class="tabla__columna-pago">Pago</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venta in Model.Filas)
            {
                <tr>
                    <td>@venta.Fecha.ToString("dd/MM/yyyy")</td>
                    <td><a asp-action="Factura" asp-route-id="@venta.VentaId">@venta.NumeroFactura</a></td>
                    <td>@venta.Producto</td>
                    <td class="tabla__numero">@venta.Cantidad</td>
                    <td class="tabla__numero">@venta.PrecioUnitario.ToString("C0")</td>
                    <td class="tabla__numero">@venta.Importe.ToString("C0")</td>
                    <td><partial name="_BadgeEstadoPago" model="venta.EstadoPago" /></td>
                </tr>
            }
            @if (Model.Filas.Count == 0)
            {
                <tr>
                    <td colspan="7" class="tabla__vacia">No hay ventas con esos filtros.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
