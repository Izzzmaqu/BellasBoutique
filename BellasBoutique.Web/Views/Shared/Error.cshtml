@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="titulo-error">Ocurrió un error</h1>
<p>No pudimos procesar tu solicitud. Intenta de nuevo en unos minutos.</p>

@if (Model.ShowRequestId)
{
    <p class="texto-pequeno">Identificador de solicitud: <code>@Model.RequestId</code></p>
}
